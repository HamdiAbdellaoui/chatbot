# ----------------------------------------------------------------------------
# Chatwoot Environment Variables
# This file configures the Chatwoot application.
# It should be placed in the same directory as the docker-compose.yml file.
# ----------------------------------------------------------------------------

# 1. Frontend URL
# The public URL for your Chatwoot instance. For local development, this is localhost:3000.
# In production, this would be your domain name (e.g., https://chat.yourdomain.com).
FRONTEND_URL=http://localhost:3000

# 2. PostgreSQL Database Configuration
# These credentials must match the ones used in the docker-compose.yml file
# for the 'postgres' service.
POSTGRES_DATABASE=chatwoot_db
POSTGRES_USERNAME=chatwoot_user
POSTGRES_PASSWORD=supersecretpassword
# The host is the service name defined in docker-compose.yml.
POSTGRES_HOST=postgres

# 3. Redis Configuration
# The URL for the Redis service. The host 'redis' is the service name
# defined in docker-compose.yml.
REDIS_URL=redis://redis:6379

# 4. Rails Secret Key
# This is a critical security key used by Rails to encrypt session data.
# Generate a new one for production using `docker-compose run chatwoot rails secret`.
# For local development, this placeholder is sufficient.
SECRET_KEY_BASE=your_very_long_and_random_secret_key_for_rails

# 5. Other Optional Settings (Defaults are usually fine for local dev)
# RAILS_ENV=development
# LOG_LEVEL=info
# ACTIVE_STORAGE_SERVICE=local

# 6. Enable Agent Bot Webhooks
# This is required to allow Chatwoot to send webhooks to external services.
ENABLE_AGENT_BOT_WEBHOOKS=true

