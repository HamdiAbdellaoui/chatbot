# This file is an example. Create a .env file in the chatbot-backend directory
# and fill it with your actual secrets before running the application.

# --- Logging ---
# Log level for the application. Can be DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Chatwoot Webhook Security ---
# This is a secret token that you define. You must use the exact same token
# when you create the Agent Bot in your Chatwoot instance.
# It is used to verify that incoming webhooks are genuinely from your Chatwoot.
CHATWOOT_WEBHOOK_SECRET="your_super_secret_webhook_token"

# --- OpenAI API Key ---
# Your secret key for accessing the OpenAI API (for GPT-4o).
OPENAI_API_KEY="sk-..."

# --- Qdrant URL ---
# The URL for your Qdrant vector database instance.
# Since we are running everything in Docker, we will later use the service name.
# For local testing outside Docker, localhost is fine.
QDRANT_URL="http://localhost:6333"
