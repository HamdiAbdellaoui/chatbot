# This file is an example. Create a .env file in the chatbot-backend directory
# and fill it with your actual secrets before running the application.

# --- Logging ---
# Log level for the application. Can be DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Admin API ---
# Protects internal admin endpoints (active learning queue, etc.).
# Requests must include: X-Admin-Token: <value>
ADMIN_API_TOKEN=""

# --- Chatwoot Webhook Security ---
# How incoming Agent Bot webhooks are authenticated:
#   token     (default) Chatwoot v4.1.0 does not sign Agent Bot webhooks, so a shared
#             secret is put in the Agent Bot "Webhook URL":
#             http://chatbot-backend:8000/api/v1/chatwoot-webhook?token=<CHATWOOT_WEBHOOK_TOKEN>
#   signature Chatwoot >= v4.13 only: verifies X-Chatwoot-Signature (HMAC-SHA256 of
#             "{X-Chatwoot-Timestamp}.{raw body}", prefixed "sha256=") with CHATWOOT_WEBHOOK_SECRET.
#   none      no check at all; logs a warning on every request. Development only.
CHATWOOT_WEBHOOK_AUTH_MODE=token

# Shared token for the "token" mode. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, every webhook is rejected with 401.
CHATWOOT_WEBHOOK_TOKEN=""

# HMAC secret for the "signature" mode (Agent Bot secret shown by Chatwoot >= v4.13).
CHATWOOT_WEBHOOK_SECRET=""

# "signature" mode: maximum accepted gap (seconds) between X-Chatwoot-Timestamp and server time.
CHATWOOT_WEBHOOK_MAX_SKEW_S=300

# Deprecated: replaced by CHATWOOT_WEBHOOK_AUTH_MODE. If CHATWOOT_WEBHOOK_AUTH_MODE is unset,
# CHATWOOT_VALIDATE_WEBHOOK_SIGNATURE=false is treated as mode "none" (with a deprecation warning).
# CHATWOOT_VALIDATE_WEBHOOK_SIGNATURE=false

# --- Chatwoot API (for sending replies back to Chatwoot) ---
# Base URL of your Chatwoot instance.
# In Docker Compose, prefer: http://chatwoot:3000
CHATWOOT_BASE_URL="http://localhost:3000"

# Personal Access Token or Bot token with API access.
CHATWOOT_API_TOKEN=""

# Your Chatwoot account id (integer). If omitted, backend will try to read it from the webhook payload.
CHATWOOT_ACCOUNT_ID=

# Strict timeout for Chatwoot API calls (messages/labels/assignments).
CHATWOOT_REQUEST_TIMEOUT_S=6

# --- OpenAI API Key ---
# Your secret key for accessing the OpenAI API (for GPT-4o).
OPENAI_API_KEY="sk-..."

# Model + request settings
OPENAI_MODEL="gpt-4o"
OPENAI_REQUEST_TIMEOUT_S=20
OPENAI_MAX_TOKENS=400

# --- PII masking (LLM privacy) ---
# Debug mode: logs only span metadata (no raw values). Keep false in production unless troubleshooting.
PII_DEBUG=false

# Optional: override minimum confidence threshold used for masking (0..1).
# If unset, the service uses per-type defaults.
# PII_MIN_CONFIDENCE=0.7

# Optional allowlist (comma-separated) of known-safe terms that should not be masked.
# Example: PII_ALLOWED_TERMS="Tunis,Sfax,Sousse"
PII_ALLOWED_TERMS=

# --- Qdrant URL ---
# The URL for your Qdrant vector database instance.
# Since we are running everything in Docker, we will later use the service name.
# For local testing outside Docker, localhost is fine.
QDRANT_URL="http://localhost:6333"

# Offline options (no Docker):
# QDRANT_URL=":memory:"           # in-memory (resets each process)
# QDRANT_URL="local:./qdrant_local" # persistent local storage directory

# Optional API key if Qdrant is secured.
QDRANT_API_KEY=""

# Default collection name used for basic retrieval demos.
QDRANT_COLLECTION="shared"

# --- Multi-store mapping (Phase 3) ---
# Optional: map Chatwoot inbox_id / inbox_name to store-specific config.
# If unset/empty, the backend uses QDRANT_COLLECTION for all inboxes.
#
# Notes:
# - Prefer matching by inbox_id (stable). inbox_name matching is a fallback.
# - Each store can point to its own Qdrant collection.
# - WooCommerce creds are not used yet in code, but stored here for next steps.
#
# Example (single-line JSON):
# Option A (direct values in JSON — simplest, but secrets are inside STORES_JSON):
# STORES_JSON='{ "default": {"qdrant_collection": "shared"}, "store_a": {"match": {"inbox_ids": [1], "inbox_names": ["Store A"]}, "qdrant_collection": "store_a", "woocommerce": {"base_url": "https://store-a.tld", "consumer_key": "ck_...", "consumer_secret": "cs_..."}} }'
#
# Option B (recommended): reference secrets from separate env vars using env:VARNAME
# WOOCOMMERCE_STORE_A_CK="ck_..."
# WOOCOMMERCE_STORE_A_CS="cs_..."
# STORES_JSON='{ "default": {"qdrant_collection": "shared"}, "store_a": {"match": {"inbox_ids": [1]}, "qdrant_collection": "store_a", "woocommerce": {"base_url": "https://store-a.tld", "consumer_key": "env:WOOCOMMERCE_STORE_A_CK", "consumer_secret": "env:WOOCOMMERCE_STORE_A_CS"}} }'
# DEFAULT_STORE_KEY="default"
STORES_JSON=
DEFAULT_STORE_KEY="default"

# --- WooCommerce (Phase 3 / Step 6) ---
# Timeout for WooCommerce API calls.
WOOCOMMERCE_REQUEST_TIMEOUT_S=12

# Developer-only: enable explicit '/wc ...' commands to hit WooCommerce directly.
# Keep disabled for production.
WOOCOMMERCE_COMMANDS_ENABLED=false

# How orders requested in chat are handled:
#   handoff (default) the model can only call `request_order`: nothing is created in WooCommerce.
#                     The backend posts a private note (product, price, quantity, masked customer note)
#                     in the Chatwoot conversation, adds ORDER_VALIDATION_LABEL and escalates to a human.
#   direct            legacy behavior: the model creates a pending WooCommerce order itself. Tests only.
WOOCOMMERCE_ORDER_MODE=handoff

# Chatwoot label added to conversations with an order request awaiting human validation.
ORDER_VALIDATION_LABEL="order_validation"

# --- Conversation session memory (multi-turn) ---
# If set, conversation history is stored in Redis (recommended; native TTL support).
# In Docker Compose: REDIS_URL="redis://redis:6379"
REDIS_URL=

# Number of most recent turns (individual user/assistant messages) kept per conversation.
SESSION_HISTORY_TURNS=6

# How long a conversation's history is retained without activity (seconds).
SESSION_TTL_SECONDS=3600

# If REDIS_URL is unset, session history falls back to PostgreSQL using
# ACTIVE_LEARNING_DATABASE_URL below. If neither is set, the bot runs without
# conversation memory (each message is handled independently).

# --- Shared PostgreSQL Database (Phase 3) ---
# Used by conversation_log_service to persist a full log of every exchange
# (masked content, RAG score, latency, escalation info, etc.).
# Example (Docker Compose): APP_DATABASE_URL="postgresql://POSTGRES_USERNAME:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DATABASE"
# If left empty, falls back to ACTIVE_LEARNING_DATABASE_URL (below) for backward compatibility.
APP_DATABASE_URL=""

# --- Active Learning Loop (Phase 3) ---
# When enabled, logs low-confidence retrieval events to PostgreSQL for supervisor review.
# You can point this to the same PostgreSQL used by Chatwoot.
ACTIVE_LEARNING_ENABLED=false
# Example (Docker Compose):
# ACTIVE_LEARNING_DATABASE_URL="postgresql://POSTGRES_USERNAME:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DATABASE"
ACTIVE_LEARNING_DATABASE_URL=""

# --- Human escalation (Phase 3) ---
# When escalation triggers, the backend adds a label to the conversation and (optionally)
# assigns it to a human agent. Once labeled, the bot suppresses any further replies.
ESCALATION_ENABLED=true
ESCALATION_LABEL="human_handoff"
ESCALATION_ACK_LABEL="human_handoff_ack"

# Optional: assign to a specific agent id.
# ESCALATION_ASSIGNEE_ID=123

# Optional: assign to a team id (used when ESCALATION_ASSIGNEE_ID is not set).
# ESCALATION_TEAM_ID=10

# Upper bound for escalation-related Chatwoot API calls per webhook.
ESCALATION_API_BUDGET_S=2.5

# Comma-separated keywords/phrases to trigger escalation.
ESCALATION_KEYWORDS="human,agent,representative,talk to someone,talk to a human,customer service,support"

# Send a one-time acknowledgement message when escalation happens.
ESCALATION_SEND_ACK=true
ESCALATION_ACK_MESSAGE="Okay — I’m connecting you to a human agent."

# Optional: auto-escalate when confidence is low.
ESCALATION_LOW_CONFIDENCE_ENABLED=false
# Deprecated: superseded by CONFIDENCE_LOW_THRESHOLD/CONFIDENCE_HIGH_THRESHOLD below. No longer read by the code.
ESCALATION_MIN_TOP_SCORE=0.15

# --- Confidence scoring (3 signals): RAG score + LLM self-assessment + business-decision rule ---
# See app/services/confidence_service.py.
# Combined score >= HIGH: normal. Between LOW and HIGH: uncertainty signal (flagged, not escalated). Below LOW: full escalation.
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.50

# Comma-separated keywords indicating a business decision (refund, dispute, order cancellation, ...) that deserves extra caution.
BUSINESS_DECISION_KEYWORDS="réclamation,litige,remboursement,remboursé,exception,annulation,annuler ma commande,annuler la commande,dispute,plainte,compensation,dédommagement,geste commercial,dérogation,refund,cancel order,cancel my order,complaint,chargeback"

# Perf: the LLM self-assessment call is a second, extra LLM round-trip (adds latency).
# When true (recommended), only call it when the RAG score is ambiguous (between LOW and HIGH thresholds).
# Set to false to always call it (e.g. to measure worst-case latency).
CONFIDENCE_LLM_SIGNAL_AMBIGUOUS_ONLY=true

# Basic retrieval tuning
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4000

# --- Embeddings (for basic Qdrant retrieval) ---
# Keep it simple initially: use OpenAI embeddings.
EMBEDDINGS_PROVIDER="openai"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Offline dev/testing option (no external API):
# EMBEDDINGS_PROVIDER="local"
# LOCAL_EMBEDDING_DIM=384

# If you later switch to sentence-transformers embeddings:
# EMBEDDINGS_PROVIDER="sentence-transformers"
# EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-large"
